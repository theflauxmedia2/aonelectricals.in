{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "aonelectricalsin.vercel.app" }],
      "destination": "https://aonelectricals.in/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.aonelectricals.in" }],
      "destination": "https://aonelectricals.in/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "aonelectricalsin.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
